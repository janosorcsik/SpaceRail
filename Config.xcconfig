// SpaceRail — shared build settings, single source of truth for both configurations.
// Per-configuration differences (bundle ID, product name) live in project.yml.

// --- Versioning -----------------------------------------------------------
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// --- Signing --------------------------------------------------------------
// A real, stable identity matters here: TCC ties the Accessibility grant to the code signature.
// Ad-hoc signing would mean re-granting after every build.
DEVELOPMENT_TEAM = 4YLAALG7M5
CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
// The app drives other apps through AX and needs no sandbox-only capability; the sandbox would
// block AXIsProcessTrusted, window manipulation and hotkeys.
ENABLE_APP_SANDBOX = NO
// No get-task-allow in shipping builds. Debug keeps it so the debugger can attach.
CODE_SIGN_INJECT_BASE_ENTITLEMENTS[config=Release] = NO

// --- Platform -------------------------------------------------------------
MACOSX_DEPLOYMENT_TARGET = 26.0
SDKROOT = macosx

// --- Swift ----------------------------------------------------------------
SWIFT_VERSION = 5.0
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_COMPILATION_MODE[config=Release] = wholemodule

// --- Assets ---------------------------------------------------------------
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
